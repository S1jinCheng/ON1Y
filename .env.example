# On1y — Phase 1 (ingestion & extraction only)
# Copy to .env and adjust paths for your machine.

# --- Paths ---
ON1Y_DATA_DIR=./data
ON1Y_DB_PATH=./data/on1y.db

# --- Worker ---
ON1Y_WORKER_POLL_SECONDS=2
ON1Y_WORKER_MAX_RETRIES=3
ON1Y_SUBTITLE_MAX_RETRIES=3
ON1Y_SUBTITLE_FETCH_DELAY_SECONDS=2.5
ON1Y_SUBTITLE_RATE_LIMIT_BACKOFF_SECONDS=60
ON1Y_SUBTITLE_ROTATE_CLASH_ON_429=true
# Clash 外部控制（WSL 访问 Windows 主机 IP:9090；Clash 需 external-controller: 0.0.0.0:9090）
# ON1Y_CLASH_API_BASE=http://172.31.128.1:9090
# ON1Y_CLASH_API_SECRET=
# ON1Y_CLASH_PROXY_GROUP=GLOBAL
# ON1Y_CLASH_API_TIMEOUT_SECONDS=5
# YouTube 字幕就绪后自动 on1y distill（需 LLM Key）
# ON1Y_AUTO_DISTILL_AFTER_SUBTITLES=true

# --- Extraction ---
ON1Y_MAX_BODY_CHARS=500000
ON1Y_JINA_READER_BASE=https://r.jina.ai/
ON1Y_HTTP_TIMEOUT_SECONDS=60
# 中英字幕语言（逗号分隔，按优先级尝试）
# 仅中英即可；越少 yt-dlp 下载越快
ON1Y_YTDLP_SUB_LANGS=zh-Hans,en
# YouTube 在 WSL 内通常需要代理（与 Windows 上 Clash/V2Ray 端口一致）
# Windows 代理 127.0.0.1:7897 → WSL 填: http://$(ip route | awk '/default/{print $3}'):7897
# ON1Y_YTDLP_PROXY=http://172.31.128.1:7897
ON1Y_YTDLP_SOCKET_TIMEOUT=30
ON1Y_YTDLP_RETRIES=3

# --- Playwright (Zhihu / Xiaohongshu / X) ---
ON1Y_PLAYWRIGHT_HEADLESS=true
ON1Y_PLAYWRIGHT_TIMEOUT_MS=60000
ON1Y_PLAYWRIGHT_SETTLE_MS=2000

# Login cookies (export via scripts/export_cookies.py) — required when REQUIRE_LOGIN_COOKIES=true
ON1Y_REQUIRE_LOGIN_COOKIES=true
ON1Y_YOUTUBE_COOKIES_PATH=./data/cookies/youtube.json
ON1Y_BILIBILI_COOKIES_PATH=./data/cookies/bilibili.json
# Bilibili UP sync: default uses 关注动态 API (type=video), not per-UP space search
# ON1Y_BILIBILI_UP_POLL_MODE=dynamic
# ON1Y_BILIBILI_UP_POLL_MODE=space
# ON1Y_BILIBILI_DYNAMIC_POLL_MAX_PAGES=5
# ON1Y_BILIBILI_UP_POLL_MAX_UPS_PER_RUN=15
# ON1Y_BILIBILI_UP_POLL_RATE_LIMIT_BACKOFF_SECONDS=45
# ON1Y_BILIBILI_UP_POLL_RATE_LIMIT_COOLDOWN_SECONDS=90
ON1Y_ZHIHU_COOKIES_PATH=./data/cookies/zhihu.json
ON1Y_XIAOHONGSHU_COOKIES_PATH=./data/cookies/xiaohongshu.json
ON1Y_TWITTER_COOKIES_PATH=./data/cookies/twitter.json

# --- RSS ---
ON1Y_RSS_CONFIG_PATH=./config/feeds.yaml
ON1Y_RSS_POLL_INTERVAL_MINUTES=30

# --- Phase 2 LLM（也可在 Web 控制台填写，存 data/llm_settings.json）---
ON1Y_LLM_BASE_URL=https://api.deepseek.com
ON1Y_LLM_API_KEY=
ON1Y_LLM_MODEL=deepseek-v4-flash
ON1Y_LLM_MAX_INPUT_CHARS=24000

# --- Web dashboard ---
ON1Y_WEB_HOST=127.0.0.1
ON1Y_WEB_PORT=8765
# Extra CORS origins for Next.js dev (comma-separated), e.g. http://localhost:3001
# ON1Y_CORS_ORIGINS=http://localhost:3001

# --- Logging ---
ON1Y_LOG_LEVEL=INFO
