# On1y — Phase 1 (ingestion & extraction only)
# Copy to .env and adjust paths for your machine.

# --- Paths ---
ON1Y_DATA_DIR=./data
ON1Y_DB_PATH=./data/on1y.db

# --- Desktop update check (dev only) ---
# ON1Y_UPDATE_CHECK_DEV=true
# ON1Y_UPDATE_GITHUB_REPO=S1jinCheng/ON1Y

# --- Worker ---
ON1Y_WORKER_POLL_SECONDS=2
ON1Y_WORKER_MAX_RETRIES=3
ON1Y_SUBTITLE_MAX_RETRIES=3
ON1Y_SUBTITLE_FETCH_DELAY_SECONDS=2.5
ON1Y_SUBTITLE_RATE_LIMIT_BACKOFF_SECONDS=60
ON1Y_SUBTITLE_ROTATE_CLASH_ON_429=true
# Clash 外部控制（WSL 访问 Windows 主机 IP:9090；Clash 需 external-controller: 0.0.0.0:9090）
# ON1Y_CLASH_API_BASE=http://172.31.128.1:9090
# ON1Y_CLASH_API_SECRET=
# ON1Y_CLASH_PROXY_GROUP=GLOBAL
# ON1Y_CLASH_API_TIMEOUT_SECONDS=5
# YouTube 字幕就绪后自动 on1y distill（需 LLM Key）
# ON1Y_AUTO_DISTILL_AFTER_SUBTITLES=true

# --- Extraction ---
ON1Y_MAX_BODY_CHARS=500000
ON1Y_JINA_READER_BASE=https://r.jina.ai/
ON1Y_HTTP_TIMEOUT_SECONDS=60
# 中英字幕语言（逗号分隔，按优先级尝试）
# 仅中英即可；越少 yt-dlp 下载越快
ON1Y_YTDLP_SUB_LANGS=zh-Hans,en
# YouTube 在 WSL 内通常需要代理（与 Windows 上 Clash/V2Ray 端口一致）
# Windows 代理 127.0.0.1:7897 → WSL 填: http://$(ip route | awk '/default/{print $3}'):7897
# ON1Y_YTDLP_PROXY=http://172.31.128.1:7897
# 经济学人周刊同步也走该代理；国内访问 GitHub 超时时必填
# ON1Y_ECONOMIST_GITHUB_RAW_BASE=https://ghfast.top/https://raw.githubusercontent.com/hehonghui/awesome-english-ebooks/master
ON1Y_YTDLP_SOCKET_TIMEOUT=30
ON1Y_YTDLP_RETRIES=3

# --- Playwright (Zhihu / Xiaohongshu / X) ---
ON1Y_PLAYWRIGHT_HEADLESS=true
ON1Y_PLAYWRIGHT_TIMEOUT_MS=60000
ON1Y_PLAYWRIGHT_SETTLE_MS=2000

# Login cookies (export via scripts/export_cookies.py) — required when REQUIRE_LOGIN_COOKIES=true
ON1Y_REQUIRE_LOGIN_COOKIES=true
ON1Y_YOUTUBE_COOKIES_PATH=./data/cookies/youtube.json
ON1Y_BILIBILI_COOKIES_PATH=./data/cookies/bilibili.json
# Bilibili UP sync: default uses 关注动态 API (type=video), not per-UP space search
# ON1Y_BILIBILI_UP_POLL_MODE=dynamic
# ON1Y_BILIBILI_UP_POLL_MODE=space
# ON1Y_BILIBILI_DYNAMIC_POLL_MAX_PAGES=5
# ON1Y_BILIBILI_UP_POLL_MAX_UPS_PER_RUN=15
# ON1Y_BILIBILI_UP_POLL_RATE_LIMIT_BACKOFF_SECONDS=45
# ON1Y_BILIBILI_UP_POLL_RATE_LIMIT_COOLDOWN_SECONDS=90
ON1Y_ZHIHU_COOKIES_PATH=./data/cookies/zhihu.json
ON1Y_XIAOHONGSHU_COOKIES_PATH=./data/cookies/xiaohongshu.json
ON1Y_TWITTER_COOKIES_PATH=./data/cookies/twitter.json

# --- RSS ---
ON1Y_RSS_CONFIG_PATH=./config/feeds.yaml
ON1Y_RSS_POLL_INTERVAL_MINUTES=30
# 知乎 RSS 需自建 RSSHub，例如 Docker 映射 http://127.0.0.1:12000
# ON1Y_ZHIHU_RSSHUB_BASE=http://127.0.0.1:12000

# on1y serve 后台自动同步 B 站 / YouTube / 知乎（无需每天手点「同步」）
ON1Y_AUTO_SYNC_ENABLED=true
ON1Y_AUTO_SYNC_INTERVAL_MINUTES=30
ON1Y_AUTO_SYNC_PLATFORM=all
ON1Y_AUTO_SYNC_INGEST=true
ON1Y_AUTO_SYNC_STARTUP_DELAY_SECONDS=120
ON1Y_AUTO_SYNC_STARTUP_POLL_ONLY=true
# Evening digest: stats + LLM summary at 22:00 (Asia/Shanghai) while serve runs
ON1Y_EVENING_DIGEST_ENABLED=true
ON1Y_EVENING_DIGEST_HOUR=22
# 并行流水线批次（与初始同步相同：拉取 / 字幕 / 摘要 三路并行，排空队列）
ON1Y_AUTO_SYNC_PIPELINE_BATCH_SIZE=25
# 以下旧上限已被并行流水线取代，可忽略
ON1Y_AUTO_SYNC_INGEST_LIMIT=25
ON1Y_AUTO_SYNC_SUBTITLE_LIMIT=25
ON1Y_AUTO_SYNC_DISTILL_LIMIT=50

# --- Phase 2 LLM（也可在 Web 控制台填写，存 data/llm_settings.json）---
ON1Y_LLM_BASE_URL=https://api.deepseek.com
ON1Y_LLM_API_KEY=
ON1Y_LLM_MODEL=deepseek-v4-flash
ON1Y_LLM_MAX_INPUT_CHARS=24000

# --- Web dashboard ---
ON1Y_WEB_HOST=127.0.0.1
ON1Y_WEB_PORT=8765
# Extra CORS origins for Next.js dev (comma-separated), e.g. http://localhost:3045
# ON1Y_CORS_ORIGINS=http://localhost:3045

# --- Economist auto-ingest + Kindle (while on1y serve is running) ---
ON1Y_ECONOMIST_AUTO_SYNC=true
ON1Y_ECONOMIST_AUTO_SYNC_INTERVAL_MINUTES=60
ON1Y_ECONOMIST_AUTO_KINDLE=true
ON1Y_KINDLE_SEND_TO=chengsijin81_waEOnP@kindle.com
# SMTP: FROM 必须是 Amazon 账号里批准的「已认可发件人」邮箱
# ON1Y_SMTP_HOST=smtp.gmail.com
# ON1Y_SMTP_PORT=587
# ON1Y_SMTP_USER=your@gmail.com
# ON1Y_SMTP_PASSWORD=your-app-password
# ON1Y_SMTP_FROM=your@gmail.com
# ON1Y_SMTP_USE_TLS=true
# 个人配置（Cookie 路径、Kindle、自动化状态）存入 SQLite user_profiles；旧版 data/user_profile.json 会迁移到首个用户
# 模板见 config/user_profile.json.example

# --- Multi-user auth (web UI / desktop) ---
# ON1Y_AUTH_SECRET_KEY=change-to-a-long-random-string
ON1Y_AUTH_REQUIRED=true
# ON1Y_AUTH_ALLOW_REGISTRATION=true
# 安装版单用户（发布包自动写入）：ON1Y_SINGLE_USER=true
# 单用户免登录模式（开发用）：ON1Y_AUTH_REQUIRED=false
# 自动创建首个管理员（留空则通过注册页创建第一个账号）
# ON1Y_BOOTSTRAP_USERNAME=admin
# ON1Y_BOOTSTRAP_PASSWORD=your-strong-password
# ON1Y_BOOTSTRAP_EMAIL=you@example.com

# --- Logging ---
ON1Y_LOG_LEVEL=INFO
