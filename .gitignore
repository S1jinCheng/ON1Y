# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
*.egg

# Testing / coverage
.pytest_cache/
.pytest_tmp/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# Type checkers / linters (local caches)
.mypy_cache/
.ruff_cache/

# IDE / editor (local rules may contain machine-specific paths)
.cursor/
.idea/
.vscode/
*.swp
*.swo
*~

# Environment & secrets
.env
.env.*
!.env.example

# Runtime data (SQLite, indexes, cookies, logs)
data/
!data/.gitkeep
cookies/

# Playwright browsers (if installed locally)
/playwright-browsers/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Local config overrides (keep *.example in repo)
config/feeds.yaml
config/local.yaml
config/zhihu_follows.txt
config/youtube_channels.txt

# Local documentation (README on GitHub is the public intro)
docs/

# Temporary files
tmp/
*.tmp

# Frontend build output
frontend/.next/
frontend/out/
frontend/tsconfig.tsbuildinfo
