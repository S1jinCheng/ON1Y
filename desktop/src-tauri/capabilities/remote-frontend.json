{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-frontend",
  "description": "Allow the workbench on on1y serve to open external URLs",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:8765", "http://localhost:8765"]
  },
  "permissions": [
    "opener:default",
    "allow-open-external-url",
    "allow-pick-data-folder",
    "allow-save-archive-file"
  ]
}
