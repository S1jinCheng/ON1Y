{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-frontend",
  "description": "Allow the Next.js workbench on localhost to open external URLs",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:3000", "http://localhost:3000"]
  },
  "permissions": [
    "opener:default",
    "allow-open-external-url"
  ]
}
