{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default On1y desktop capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-center",
    "opener:default",
    "allow-open-zotero-pdf",
    "allow-pick-data-folder",
    "allow-save-archive-file"
  ]
}
